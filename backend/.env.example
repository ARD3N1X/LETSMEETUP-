# --- Serwer ---
PORT=3000
# Publiczny adres serwera (używany w linkach do avatarów)
PUBLIC_URL=http://localhost:3000
DATABASE_URL=postgresql://letsmeetup:letsmeetup@localhost:5432/letsmeetup?schema=public

# --- JWT --- (ZMIEŃ w produkcji! np. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# --- E-mail (Mailpit z docker-compose: http://localhost:8025) ---
# Bez SMTP_HOST kody weryfikacyjne są wypisywane w logach serwera.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="LET`SMEETUP <no-reply@letsmeetup.local>"
REQUIRE_EMAIL_VERIFICATION=true

# Alternatywa dla SMTP: klucz API Brevo (wysyłka przez HTTPS — działa też tam, gdzie porty SMTP są zablokowane).
BREVO_API_KEY=

# --- Push (opcjonalnie) ---
# Ścieżka do pliku konta serwisowego Firebase (JSON). Puste = push wyłączony.
FIREBASE_SERVICE_ACCOUNT_FILE=

# --- Limity ---
MAX_GROUP_MEMBERS=100
MAX_GROUPS_PER_USER=20
